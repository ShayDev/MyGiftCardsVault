# Example environment variables for myGiftCardsVault
# Copy this file to `.env.local` and fill in real values for local development.

# PostgreSQL connection URL (set your DB credentials and host)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://dbuser:secret@localhost:5432/mygiftcardsvault?schema=public"

# Direct (non-pooled) connection — used by the Prisma CLI (migrate/generate/studio), see
# prisma.config.ts. On Neon this is the same host as DATABASE_URL minus "-pooler"; for a
# plain local Postgres instance it can just be the same value as DATABASE_URL.
DIRECT_URL="postgresql://dbuser:secret@localhost:5432/mygiftcardsvault?schema=public"

# Clerk authentication — get these from clerk.com dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Field encryption — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_hex_chars

# Vercel Blob — get from Vercel dashboard → Storage → Blob → your store → .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Google Gemini API — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Anthropic (Claude) API — get from https://console.anthropic.com/settings/keys
# Alternative Scan engine, selectable per-family in Settings — see lib/familySettings.ts.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Groq API — get a free key (no card required) from https://console.groq.com/keys
# Third Scan engine option — genuinely free tier, see lib/extractEngines.ts.
GROQ_API_KEY=your_groq_api_key

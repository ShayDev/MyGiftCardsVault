generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum TransactionType {
  RECHARGE
  SPEND
}

model FamilyGroup {
  id          String        @id @default(uuid())
  name        String        // stored uppercase e.g. "THE SMITHS"
  inviteCode  String        @unique
  ownerId     String        @unique // creator of this family; a user can own at most one family
  owner       User          @relation("FamilyOwner", fields: [ownerId], references: [id])
  users       User[]        @relation("FamilyMembers")
  giftCards   GiftCard[]
  vouchers    Voucher[]
  clubMembers ClubMember[]
  refunds     Refund[]
  warranties  Warranty[]
  settings    String?       // JSON-encoded family preferences — see lib/familySettings.ts
  createdAt   DateTime      @default(now())
}

model User {
  id          String       @id @default(uuid())
  clerkId     String       @unique
  email       String       @unique
  name        String?
  role        String       @default("member")
  familyId    String?
  family      FamilyGroup? @relation("FamilyMembers", fields: [familyId], references: [id])
  ownedFamily FamilyGroup? @relation("FamilyOwner")
  createdAt   DateTime     @default(now())
}

model GiftCard {
  id           String        @id @default(uuid())
  seq          Int           @default(autoincrement())
  familyId     String
  family       FamilyGroup   @relation(fields: [familyId], references: [id])
  name         String
  provider     String
  last4        String?       // last 4 digits, required unless link provided
  fullNumber   String?       // full card number, optional
  cvv          String?       // CVV/CVC, optional
  link         String?       // one-time URL (dynamic code via link)
  expiresAt    DateTime?
  notes        String?       // card notes, optional
  isReloadable Boolean       @default(true)
  isActive     Boolean       @default(true)
  metadata     Json?
  transactions Transaction[]
  createdBy    String?
  createdAt    DateTime      @default(now())
}

model Transaction {
  id         String          @id @default(uuid())
  giftCardId String
  giftCard   GiftCard        @relation(fields: [giftCardId], references: [id])
  type       TransactionType
  // Positive decimal amount. Interpretation: RECHARGE adds, SPEND subtracts.
  amount     Decimal         @db.Decimal(65, 30)
  notes      String?
  createdBy  String?
  createdAt  DateTime        @default(now())
}

model ClubMember {
  id          String      @id @default(uuid())
  seq         Int         @default(autoincrement())
  familyId    String
  family      FamilyGroup @relation(fields: [familyId], references: [id])
  name        String
  provider    String
  memberId    String?
  ownerName   String?
  idType      String?
  expiresAt   DateTime?
  notes       String?
  isActive    Boolean     @default(true)
  createdBy   String?
  createdAt   DateTime    @default(now())
}

model Refund {
  id          String    @id @default(uuid())
  seq         Int       @default(autoincrement())
  familyId    String
  family      FamilyGroup @relation(fields: [familyId], references: [id])
  provider    String
  amount      Decimal   @db.Decimal(65, 30)
  currency    String
  status      String    @default("pending")
  referenceId String?
  notes       String?
  expiresAt   DateTime?
  receivedAt  DateTime?
  code        String?
  link        String?
  imageUrl    String?
  usedAmount  Decimal   @default(0) @db.Decimal(65, 30)
  isUsed      Boolean   @default(false)
  usedAt      DateTime?
  isActive    Boolean   @default(true)
  createdBy   String?
  createdAt   DateTime  @default(now())
}

model UserLoginStat {
  clerkId      String   @id
  loginCount   Int      @default(1)
  visitCount   Int      @default(0)
  lastLoginAt  DateTime @default(now())
  lastVisitAt  DateTime @default(now())
  os           String?  // 'android' | 'ios' | 'web' — detected client-side, refreshed on every visit
  pwaInstalled Boolean  @default(false) // forward-only: no browser event exists for uninstall, so this only ever flips true, never back
}

model Voucher {
  id          String      @id @default(uuid())
  seq         Int         @default(autoincrement())
  familyId    String
  family      FamilyGroup @relation(fields: [familyId], references: [id])
  name        String
  provider    String
  code        String?
  link        String?
  value       Decimal?    @db.Decimal(65, 30)
  expiresAt   DateTime?
  notes       String?
  isUsed      Boolean     @default(false)
  usedAt      DateTime?
  usedBy      String?
  isActive    Boolean     @default(true)
  createdBy   String?
  createdAt   DateTime    @default(now())
}

// familyId here is intentionally NOT a FK — '0' is a sentinel for "shared
// across all families" and has no matching FamilyGroup row. See
// plans/provider-field-hld.md for the full design rationale.
model Provider {
  id              String   @id @default(uuid())
  type            String
  name            String?
  nameByCountry   String?
  country         String   @default("IL")
  familyId        String   @default("0")
  balanceCheckUrl String?  // provider's balance-check page — not wired up yet, reserved for a future feature
  createdBy       String?
  createdAt       DateTime @default(now())

  @@index([type, country, familyId])
}

// Directory of companies (stores, manufacturers, service centers) used by
// Warranty for BOTH the "purchased from" and "claim with" roles — the same
// company is frequently both, and either field can reuse an entry the other
// created. Not part of the generic Provider table above: Provider is shaped
// for "just a display name" (Cards/Vouchers/Clubs/Refunds); this table needs
// phone/url too, which none of those four types ever populate. familyId
// follows the same non-FK '0' = shared/global sentinel as Provider.familyId
// — see plans/warranty-dd.md.
model WarrantyProvider {
  id            String   @id @default(uuid())
  familyId      String   @default("0")
  name          String?
  phone         String?
  url           String?
  nameByCountry String?
  country       String   @default("IL")
  createdBy     String?
  createdAt     DateTime @default(now())

  purchasedWarranties Warranty[] @relation("PurchasedFrom")
  claimedWarranties   Warranty[] @relation("ClaimWith")

  @@index([familyId])
}

// Status (Active/Expired) is deliberately computed from expiresAt, not
// stored — no isUsed/status column, unlike Voucher/Refund. See
// plans/warranty-hld.md's Ledger Rule callout.
model Warranty {
  id                String            @id @default(uuid())
  seq               Int               @default(autoincrement())
  familyId          String
  family            FamilyGroup       @relation(fields: [familyId], references: [id])
  productName       String
  purchasedFromId   String
  purchasedFrom     WarrantyProvider  @relation("PurchasedFrom", fields: [purchasedFromId], references: [id])
  branch            String?           // physical branch/location of purchasedFrom, e.g. "Rishon LeZion" — free text, not a relation
  warrantyCompanyId String?           // who to claim with, if different from purchasedFrom — null means "same as purchasedFrom"
  warrantyCompany   WarrantyProvider? @relation("ClaimWith", fields: [warrantyCompanyId], references: [id])
  purchaseDate      DateTime?
  durationMonths    Int?              // warranty length in months, display/reference only — expiresAt is authoritative
  expiresAt         DateTime?
  referenceId       String?
  notes             String?
  link              String?           // encrypted at rest, see lib/encrypt.ts
  imageUrl          String?
  isActive          Boolean           @default(true)
  createdBy         String?
  createdAt         DateTime          @default(now())
}
